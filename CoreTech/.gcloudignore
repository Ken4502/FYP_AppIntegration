# .gcloudignore file to keep Cloud Run builds fast and lightweight
.git/
.gitignore
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
*.log

# Exclude legacy non-experiment folders
Plant_Disease/
Plant_Identification/

# Exclude training datasets and evaluation benchmarks
Plant_Disease_Experiment/data/
Plant_Identification_Experiment/data/
Plant_Disease_Experiment/reports/
Plant_Identification_Experiment/reports/

# Exclude older training checkpoint iterations
Plant_Identification_Experiment/artifacts/best_model_102.pth
Plant_Identification_Experiment/artifacts/best_model_prev_250.pth
Plant_Identification_Experiment/artifacts/best_model_pre_active_learning.pth

