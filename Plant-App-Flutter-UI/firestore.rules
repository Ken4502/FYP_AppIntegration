rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Development / Testing Mode:
    // Full read and write access granted to all collections and subcollections
    // (including iot_devices, provisioning, plants, users, orders, carts, etc.)
    // to allow unhindered testing across ESP32 firmware and Flutter clients.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
