rules_version = '2';

// ===============================================================
// Assumed Data Model & Security Architecture
// ===============================================================
//
// Collection: admin
// Document ID: {adminId} (matches Firebase Auth UID)
// Fields:
//   - uid: string (matches adminId)
//   - role: string ("admin")
//   - email: string
// Access: Only the designated admin can read/write their admin profile.
//
// Collection: users
// Document ID: {userId} (matches Firebase Auth UID)
// Fields:
//   - uid: string (matches userId)
//   - email: string
//   - username: string
//   - photoUrl: string (optional)
//   - gardenPlants: list (optional)
//   - gardenPlantsCount: number (optional)
//   - gardenLastSaved: timestamp (optional)
//   - createdAt: timestamp (optional)
//   - updatedAt: timestamp (optional)
// Access: Owner and Admin can read/write; users can create own account.
//
// Subcollection: users/{userId}/addresses
// Document ID: {addressId}
// Fields:
//   - street: string, city: string, state: string, zipCode: string, isDefault: bool, updatedAt: timestamp
// Access: Owner and Admin can read, create, update, and delete addresses.
//
// Subcollection: users/{userId}/orders
// Document ID: {orderId} (e.g. "UG-123456")
// Fields:
//   - id: string, userId: string, items: list, subtotal: number, deliveryFee: number,
//     totalAmount: number, shippingAddress: map, paymentMethod: string, status: string,
//     createdAt: timestamp, cancelledAt: timestamp (optional)
// Access: Owner and Admin can read, create, and update (cancel); admin can delete.
//
// Subcollection: users/{userId}/cart
// Document ID: {cartDoc} (e.g. "current")
// Access: Owner and Admin can read and write cart items.
//
// Collection: orders (Root collection for auditing & store orders)
// Document ID: {orderId}
// Fields:
//   - id: string, userId: string (matches customer UID), items: list, subtotal: number,
//     deliveryFee: number, totalAmount: number, shippingAddress: map, paymentMethod: string,
//     status: string, createdAt: timestamp, cancelledAt: timestamp (optional)
// Access: Owner can create their order and read/update their order. Admin has full access.
//
// Collection: carts
// Document ID: {userId} (matches customer auth UID)
// Access: Owner and Admin can read and write shopping cart state.
//
// Collection: provisioning
// Document ID: {setupToken}
// Fields:
//   - setupToken: string (matches document ID)
//   - userId: string (customer UID)
//   - deviceId: string
//   - status: string ("pending" | "connected" | "failed")
//   - ssid: string
//   - createdAt: timestamp
//   - connectedAt: timestamp (optional)
//   - ip: string (optional)
//   - errorMessage: string (optional)
// Access: Authenticated user creates session; user/admin or token bearer can read;
//         user/admin or ESP32 micro-controller can update status; user/admin can delete.
//
// Collection: iot_devices
// Document ID: {deviceId}
// Fields:
//   - id: string, userId: string, registeredBy: string, name: string, ssid: string,
//     homeSsid: string, firmwareVersion: string, lastSeen: timestamp, lastReadingAt: timestamp,
//     lastWateredAt: timestamp, lastRegistered: string, lastUpdated: timestamp,
//     createdAt: timestamp, updatedAt: timestamp, moisturePercent: number, moisture: number,
//     rawADC: number, raw: number, isPumpRunning: bool, pump: bool|number, mode: string,
//     autoWaterEnabled: bool, lowThreshold: number, highThreshold: number,
//     linkedPlantId: string, linkedPlantName: string, linkedPlantImage: string,
//     pendingCommand: string|map, isWifiConnected: bool, wifiConnected: bool,
//     hostPhone: string, hostDeviceId: string, stationIp: string, status: string, msg: string
// Access: Authenticated users can read telemetry; device owner or admin can register/update;
//         ESP32 REST API can update telemetry data; owner or admin can delete.
//
// Subcollection: iot_devices/{deviceId}/logs
// Document ID: {logId}
// Fields:
//   - id: string, deviceId: string, timestamp: timestamp, createdAt: timestamp,
//     event: string, type: string, title: string, message: string, detail: string,
//     moisturePercent: number, rawADC: number, isPumpRunning: bool, pump: bool|number, userId: string
// Access: Authenticated users can read logs; devices/owners can append logs; admin can delete.
//
// Collection: plants
// Document ID: {plantId}
// Access: Authenticated users can read catalog; admin can create/update/delete.
//
// Collection: plant_supplies
// Document ID: {itemId}
// Access: Publicly readable for store browsing; admin can create/update/delete.
//
// Collection: admin_activity
// Document ID: {logId}
// Access: Strictly administrator only.
//
// Collection: admin_sessions
// Subcollections: sessions, events
// Access: Strictly administrator only.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admin/$(request.auth.uid));
    }

    function validOptionalString(field, maxLen) {
      return !(field in request.resource.data) ||
             request.resource.data[field] == null ||
             (request.resource.data[field] is string && request.resource.data[field].size() <= maxLen);
    }

    function validOptionalNumber(field) {
      return !(field in request.resource.data) ||
             request.resource.data[field] == null ||
             request.resource.data[field] is number;
    }

    function validOptionalBool(field) {
      return !(field in request.resource.data) ||
             request.resource.data[field] == null ||
             request.resource.data[field] is bool;
    }

    function validOptionalTimestamp(field) {
      return !(field in request.resource.data) ||
             request.resource.data[field] == null ||
             request.resource.data[field] is timestamp;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidProvisioning() {
      let d = request.resource.data;
      let allowedKeys = [
        'setupToken', 'userId', 'deviceId', 'status', 'ssid',
        'createdAt', 'connectedAt', 'ip', 'errorMessage'
      ];
      return d.keys().hasAll(['setupToken', 'userId', 'deviceId', 'status', 'ssid', 'createdAt']) &&
             d.keys().hasOnly(allowedKeys) &&
             d.setupToken is string && d.setupToken.size() > 0 && d.setupToken.size() <= 128 &&
             d.userId is string && d.userId.size() > 0 && d.userId.size() <= 128 &&
             d.deviceId is string && d.deviceId.size() > 0 && d.deviceId.size() <= 128 &&
             d.status in ['pending', 'connected', 'failed'] &&
             d.ssid is string && d.ssid.size() <= 64 &&
             d.createdAt is timestamp &&
             (!('connectedAt' in d) || d.connectedAt == null || d.connectedAt is timestamp) &&
             (!('ip' in d) || d.ip == null || (d.ip is string && d.ip.size() <= 64)) &&
             (!('errorMessage' in d) || d.errorMessage == null || (d.errorMessage is string && d.errorMessage.size() <= 500));
    }

    function isValidIotDevice() {
      let d = request.resource.data;
      let allowedDeviceKeys = [
        'id', 'device', 'userId', 'registeredBy', 'name', 'ssid', 'homeSsid',
        'firmwareVersion', 'lastSeen', 'lastReadingAt', 'lastWateredAt',
        'lastRegistered', 'lastUpdated', 'createdAt', 'updatedAt',
        'moisturePercent', 'moisture', 'rawADC', 'raw',
        'isPumpRunning', 'pump', 'mode', 'autoWaterEnabled',
        'lowThreshold', 'highThreshold', 'linkedPlantId', 'linkedPlantName',
        'linkedPlantImage', 'pendingCommand', 'isWifiConnected', 'wifiConnected',
        'hostPhone', 'hostDeviceId', 'stationIp', 'status', 'msg'
      ];
      return d.keys().hasOnly(allowedDeviceKeys) &&
             validOptionalString('id', 128) &&
             validOptionalString('device', 128) &&
             validOptionalString('userId', 128) &&
             validOptionalString('registeredBy', 128) &&
             validOptionalString('name', 128) &&
             validOptionalString('ssid', 64) &&
             validOptionalString('homeSsid', 64) &&
             validOptionalString('firmwareVersion', 64) &&
             validOptionalTimestamp('lastSeen') &&
             validOptionalTimestamp('lastReadingAt') &&
             validOptionalTimestamp('lastWateredAt') &&
             validOptionalTimestamp('lastUpdated') &&
             validOptionalTimestamp('createdAt') &&
             validOptionalTimestamp('updatedAt') &&
             validOptionalNumber('moisturePercent') &&
             validOptionalNumber('moisture') &&
             validOptionalNumber('rawADC') &&
             validOptionalNumber('raw') &&
             validOptionalBool('isPumpRunning') &&
             validOptionalBool('autoWaterEnabled') &&
             validOptionalBool('isWifiConnected') &&
             validOptionalBool('wifiConnected') &&
             validOptionalNumber('lowThreshold') &&
             validOptionalNumber('highThreshold') &&
             validOptionalString('mode', 32) &&
             validOptionalString('linkedPlantId', 128) &&
             validOptionalString('linkedPlantName', 128) &&
             validOptionalString('linkedPlantImage', 1000) &&
             validOptionalString('hostPhone', 128) &&
             validOptionalString('hostDeviceId', 128) &&
             validOptionalString('stationIp', 64) &&
             validOptionalString('status', 64) &&
             validOptionalString('msg', 500) &&
             validOptionalString('lastRegistered', 64) &&
             (!('pump' in d) || d.pump == null || d.pump is bool || d.pump is number) &&
             (!('pendingCommand' in d) || d.pendingCommand == null || (d.pendingCommand is string && d.pendingCommand.size() <= 500) || d.pendingCommand is map);
    }

    function isValidDeviceLog() {
      let d = request.resource.data;
      let allowedLogKeys = [
        'id', 'deviceId', 'timestamp', 'createdAt', 'event', 'type',
        'title', 'message', 'detail', 'moisturePercent', 'rawADC',
        'isPumpRunning', 'pump', 'userId'
      ];
      return d.keys().hasOnly(allowedLogKeys) &&
             validOptionalString('id', 128) &&
             validOptionalString('deviceId', 128) &&
             validOptionalTimestamp('timestamp') &&
             validOptionalTimestamp('createdAt') &&
             validOptionalString('event', 128) &&
             validOptionalString('type', 128) &&
             validOptionalString('title', 128) &&
             validOptionalString('message', 500) &&
             validOptionalString('detail', 500) &&
             validOptionalNumber('moisturePercent') &&
             validOptionalNumber('rawADC') &&
             validOptionalBool('isPumpRunning') &&
             (!('pump' in d) || d.pump == null || d.pump is bool || d.pump is number) &&
             validOptionalString('userId', 128);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Admin profiles & verification
    match /admin/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow write: if signedIn() && request.auth.uid == adminId;
    }

    // User profiles and nested subcollections
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId;
      allow update, delete: if signedIn() && (request.auth.uid == userId || isAdmin());

      // Addresses subcollection for shipping & delivery
      match /addresses/{addressId} {
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow create, update, delete: if signedIn() && (request.auth.uid == userId || isAdmin());
      }

      // Orders subcollection for personal purchase history
      match /orders/{orderId} {
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow create, update: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow delete: if isAdmin();
      }

      // Cart subcollection for persisting shopping cart
      match /cart/{cartDoc} {
        allow read, write: if signedIn() && (request.auth.uid == userId || isAdmin());
      }

      // Recursive wildcard for any other user-specific subcollections
      match /{allChildren=**} {
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow write: if signedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // Global / Root customer orders collection
    match /orders/{orderId} {
      // Authenticated users can read their own orders; admins can view all orders
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      // Authenticated users can create orders where userId matches their authenticated UID
      allow create: if signedIn() && (
        request.resource.data.userId == request.auth.uid || isAdmin()
      );

      // Authenticated users can update their own orders (e.g. cancellation), without changing ownership
      allow update: if signedIn() && (
        (resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId) ||
        isAdmin()
      );

      // Only administrators can delete root order documents
      allow delete: if isAdmin();
    }

    // Shopping carts collection (keyed by userId)
    match /carts/{userId} {
      allow read, write: if signedIn() && (request.auth.uid == userId || isAdmin());
    }

    // SoftAP one-time Wi-Fi setup handshake & verification sessions
    match /provisioning/{setupToken} {
      // Get single session: owner, admin, or device/client with known high-entropy token ID
      allow get: if (signedIn() && (resource.data.userId == request.auth.uid || isAdmin())) ||
                    (setupToken is string && setupToken.size() >= 8);

      // List sessions: strictly limited to the authenticated user for their own sessions or admin
      allow list: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      // Create session: authenticated user matching the userId payload
      allow create: if signedIn() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.setupToken == setupToken &&
                       isValidProvisioning();

      // Update session: session owner, admin, or unauthenticated ESP32 HTTPS REST handshake confirmation
      allow update: if isValidProvisioning() &&
                       request.resource.data.setupToken == resource.data.setupToken &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.deviceId == resource.data.deviceId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       (
                         (signedIn() && (resource.data.userId == request.auth.uid || isAdmin())) ||
                         (request.resource.data.status in ['connected', 'failed'])
                       );

      // Delete session: session owner or admin
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // IoT hardware devices and operational telemetry
    match /iot_devices/{deviceId} {
      // Authenticated users can view devices
      allow read: if signedIn();

      // Registration: authenticated owner or admin
      allow create: if signedIn() &&
                       (
                         (request.resource.data.userId == request.auth.uid) ||
                         (request.resource.data.registeredBy == request.auth.uid) ||
                         isAdmin()
                       ) &&
                       isValidIotDevice();

      // Updates: owner/admin or micro-controller ESP32 telemetry updates over REST API
      allow update: if isValidIotDevice() &&
        (
          // Authenticated owner or admin
          (signedIn() && (
            (resource.data.userId == request.auth.uid) ||
            (resource.data.registeredBy == request.auth.uid) ||
            isAdmin()
          ) && (
            (!('userId' in resource.data) || request.resource.data.userId == resource.data.userId || isAdmin()) &&
            (!('registeredBy' in resource.data) || request.resource.data.registeredBy == resource.data.registeredBy || isAdmin()) &&
            (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
          )) ||
          // ESP32 device REST API telemetry reporting (unauthenticated/hardware agent)
          (
            (!('userId' in resource.data) || request.resource.data.userId == resource.data.userId) &&
            (!('registeredBy' in resource.data) || request.resource.data.registeredBy == resource.data.registeredBy) &&
            (!('id' in resource.data) || request.resource.data.id == resource.data.id) &&
            (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lastSeen', 'lastReadingAt', 'lastWateredAt', 'lastUpdated', 'updatedAt',
              'moisturePercent', 'moisture', 'rawADC', 'raw',
              'isPumpRunning', 'pump', 'mode', 'autoWaterEnabled',
              'lowThreshold', 'highThreshold', 'stationIp', 'ssid',
              'isWifiConnected', 'wifiConnected', 'firmwareVersion',
              'status', 'msg', 'pendingCommand', 'name'
            ])
          )
        );

      // Delete: device owner or admin
      allow delete: if signedIn() && (
        (resource.data.userId == request.auth.uid) ||
        (resource.data.registeredBy == request.auth.uid) ||
        isAdmin()
      );

      // Device activity & telemetry history logs subcollection
      match /logs/{logId} {
        allow read: if signedIn();
        allow create: if isValidDeviceLog();
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // Plant catalog
    match /plants/{plantId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Plant supplies catalog (e-commerce shop items)
    match /plant_supplies/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Admin activity audit logs
    match /admin_activity/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Admin sessions
    match /admin_sessions/{adminId}/sessions/{sessionId} {
      allow read: if isAdmin() && request.auth.uid == adminId;
      allow create: if isAdmin() && request.auth.uid == adminId;
      allow update, delete: if isAdmin() && request.auth.uid == adminId;
    }

    // Admin session events
    match /admin_sessions/{adminId}/sessions/{sessionId}/events/{eventId} {
      allow read: if isAdmin() && request.auth.uid == adminId;
      allow create: if isAdmin() && request.auth.uid == adminId;
      allow update, delete: if isAdmin() && request.auth.uid == adminId;
    }

    // Default deny for all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
